# ===== AI 模型配置 =====
# API Key (必填)
LLM_API_KEY=sk-your-api-key-here

# API Base URL (必填)
# SiliconFlow: https://api.siliconflow.cn/v1
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com/v1
# 本地Ollama:  http://localhost:11434/v1
LLM_API_BASE_URL=https://api.siliconflow.cn/v1

# 模型名称
# SiliconFlow: Qwen/Qwen2.5-72B-Instruct, deepseek-ai/DeepSeek-V3, XiaoMi/MiMo-v2-omni 等
# OpenAI:      gpt-4o, gpt-4o-mini
# DeepSeek:    deepseek-chat
LLM_MODEL=mimo-v2-omni

# ===== 服务器配置 =====
HOST=0.0.0.0
PORT=9000
SECRET_KEY=change-this-to-a-random-secret-key

# ===== 数据库 =====
DATABASE_URL=sqlite+aiosqlite:///./ai_interview.db

# ===== 邮件配置 (可选) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AI Interview <noreply@example.com>

# ===== 面试设置 =====
INTERVIEW_ROUNDS=10
